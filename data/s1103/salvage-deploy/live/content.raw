<td>100</td>
<td>100</td>
</tr>
<tr>
<td>Rate cards</td>
<td>unlimited</td>
<td>unlimited</td>
</tr>
<tr>
<td>Set, price, list, resolve lines</td>
<td>yes</td>
<td>yes</td>
</tr>
<tr>
<td>Price list (text)</td>
<td>yes</td>
<td>yes</td>
</tr>
<tr>
<td>Delete an unused SKU</td>
<td>yes</td>
<td>yes</td>
</tr>
<tr>
<td>Price tiers beyond <code>standard</code></td>
<td>no</td>
<td>yes</td>
</tr>
<tr>
<td>Price list (PDF)</td>
<td>no</td>
<td>yes</td>
</tr>
<tr>
