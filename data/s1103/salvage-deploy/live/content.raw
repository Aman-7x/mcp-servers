async function stripeList(env2, path, params = []) {
  const records = [];
  let cursor;
  do {
    const query = new URLSearchParams({ limit: "100", ...Object.fromEntries(params) });
    if (cursor) query.set("starting_after", cursor);
    const response = await fetch(`https://api.stripe.com${path}?${query}`, {
      headers: { Authorization: `Bearer ${env2.STRIPE_SECRET_KEY}` },
      signal: AbortSignal.timeout(3e4)
    });
    assert3(response.ok, `Stripe ${path} read failed (HTTP ${response.status})`);
    const page2 = await response.json();
    assert3(
      page2?.object === "list" && Array.isArray(page2.data) && typeof page2.has_more === "boolean",
      `Stripe ${path} response malformed`
    );
    records.push(...page2.data);
    assert3(records.length <= MAX_OBJECTS, `Stripe ${path} exceeded ${MAX_OBJECTS} objects`);
    if (!page2.has_more) return records;
    const next = page2.data.at(-1)?.id;
    assert3(next && next !== cursor, `Stripe ${path} pagination stalled`);
    cursor = next;
  } while (true);
}
