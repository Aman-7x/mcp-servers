    measured: "The suite is 8 tests, 8 passing, 0 failing (node --test), covering link extraction and classification, rel-splitting, page-level robots guards and the Pro gate on batch size. The smoke and license-gate tests sit alongside it."
  },
  "purchase-requisition": {
