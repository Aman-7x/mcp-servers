}
__name(probeBuyPages, "probeBuyPages");
async function checkBuyBatch(env2, now, batch, ctx, route) {
  const version2 = env2.CF_VERSION_METADATA?.id;
  const approved = await env2.REMOTE_DATA.get(APPROVED_VERSION);
  assert3(version2 && approved && version2 === approved, "deployed version differs from approved release");
  const created = now - 1;
  const source = `monitor.get.${crypto.randomUUID().replaceAll("-", "")}`;
  const before = await stripeList(env2, "/v1/checkout/sessions", [["created[gte]", created]]);
  const beforeIds = new Set(before.map((session) => session.id));
  const paths = await probeBuyPages(batch, source, env2, ctx, route);
  const after = await stripeList(env2, "/v1/checkout/sessions", [["created[gte]", created]]);
  assert3(
    !after.some((session) => !beforeIds.has(session.id) && (session.metadata?.source === source || session.metadata?.request_method !== "POST")),
    "new live Stripe Session attributable to GET checkout probe"
  );
  assert3(env2.CF_VERSION_METADATA?.id === version2, "deployed version changed during checkout probe");
  return { paths, batch, version: version2 };
}
