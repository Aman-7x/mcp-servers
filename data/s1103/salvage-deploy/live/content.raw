async function listWebhookStatuses(env2, since) {
  let cursor;
  let inspected = 0;
  let failed = 0;
  do {
    const page2 = await env2.REMOTE_DATA.list({ prefix: WEBHOOK_PREFIX, cursor });
    assert3(Array.isArray(page2.keys), "webhook status list malformed");
    for (const key of page2.keys) {
      const timestamp = Number(key.name.slice(WEBHOOK_PREFIX.length, WEBHOOK_PREFIX.length + 13));
      if (!Number.isSafeInteger(timestamp) || timestamp < since * 1e3) continue;
      inspected++;
      const raw = await env2.REMOTE_DATA.get(key.name);
      assert3(/^\d{3}$/.test(raw || ""), "webhook status record malformed");
      const status = Number(raw);
      if (status >= 400 && status <= 599) failed++;
