var SUPPLIER_DEMO_HTML = `<section id="supplier-demo" aria-labelledby="supplier-demo-heading">
<style>
#supplier-demo{border:1px solid var(--bd);padding:20px;margin:24px 0;background:#101010;overflow-wrap:anywhere}#supplier-demo h2{margin-top:0}#supplier-demo label{display:block;margin:12px 0 6px}#supplier-demo textarea,#supplier-demo select{box-sizing:border-box;width:100%;padding:10px;background:#080808;color:var(--fg);border:1px solid #555;font:inherit}#supplier-demo textarea{font:13px/1.5 monospace;min-height:300px;resize:vertical}#supplier-demo button{padding:10px 16px;margin:12px 8px 4px 0;border:1px solid var(--ac);background:var(--ac);color:#080808;font:inherit;cursor:pointer}#supplier-demo button:disabled{opacity:.5;cursor:default}#supplier-demo :is(textarea,select,button):focus-visible{outline:2px solid var(--ac);outline-offset:3px}#supplier-demo-status{font-weight:600}#supplier-demo-status[data-status="invalid"],#supplier-demo-status[data-status="discrepancies_for_review"]{color:var(--warn)}#supplier-demo-groups{padding-left:22px}#supplier-demo-groups li{margin:16px 0}#supplier-demo-groups p{margin:5px 0}#supplier-demo-output{max-height:440px;overflow:auto;font-size:12px}@media(max-width:540px){#supplier-demo{padding:14px}}
</style>
<style>${SUPPLIER_CSV_IMPORT_CSS}</style>
<h2 id="supplier-demo-heading">Compare supplier statement open items in this browser</h2>
<p>Choose two local CSV exports, edit the synthetic example or paste structured open items. The local MCP server uses this same comparison engine. No account or install is needed.</p>
<p class="muted">The comparison runs on your device. Field values are not uploaded, no diagnostic requests are sent, and no browser storage is written. This compares supplied invoice and credit-note open items only. It does not reconcile balances, allocate payments, extract a PDF or authorize payment.</p>
${SUPPLIER_CSV_IMPORT_HTML}
<label for="supplier-demo-preset">Worked example or edit the JSON input</label><select id="supplier-demo-preset"><option value="worked">Agreement, missing items, differences and a repeated reference</option><option value="agreement">One matching open item on each side</option><option value="zeros">Leading zeros stay significant</option><option value="credit">Credit notes and invoices are separate</option><option value="ambiguous">Repeated reference: no guessed pairing</option><option value="custom" disabled>CSV or edited input</option></select>
<form id="supplier-demo-form"><label for="supplier-demo-input">Structured JSON input (up to 1,000 records per side, 2 MiB total text)</label><textarea id="supplier-demo-input" rows="18" spellcheck="false" required aria-describedby="supplier-demo-help"></textarea>
<p id="supplier-demo-help">Declare the common <code>as_of</code> date. Exact matching uses entity, supplier, currency, document type and reference. Use unique record IDs within each side, real ISO dates and positive integer <code>outstanding_minor</code> amounts. USD 10000 means $100.00. Credit notes use positive absolute amounts and match only credit notes. Set <code>save</code> to false.</p>
<button type="submit">Compare open items locally</button><button id="supplier-demo-csv" type="button" disabled>Download full evidence CSV</button></form>
