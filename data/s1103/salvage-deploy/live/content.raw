var ORIGIN = "https://mcp.zovo.one";
var WEBHOOK = `${ORIGIN}/webhook`;
var MAX_OBJECTS = 1e4;
var SETTLE_SECONDS = 15 * 60;
var BATCHES = 5;
var APPROVED_VERSION = "monitor:approved-version";
var STATUS_KEY = "monitor:status";
var WEBHOOK_PREFIX = "monitor:webhook-status:";
