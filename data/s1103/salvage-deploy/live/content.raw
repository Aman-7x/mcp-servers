:root{color-scheme:dark;--bg:#0a0a0a;--fg:#e8e8e8;--mut:#888;--bd:#222;--ac:#06b6d4;--ok:#22c55e;--warn:#eab308;--pur:#a855f7;--red:#ef4444}
