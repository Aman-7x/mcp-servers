async function sendMail(env2, payload, label) {
  if (!env2.RESEND_API_KEY) {
    console.error(`${label} skipped: RESEND_API_KEY not set`);
    return "no_api_key";
  }
  try {
    const res = await fetch("https://api.resend.com/emails", {
      method: "POST",
      headers: { "authorization": `Bearer ${env2.RESEND_API_KEY}`, "content-type": "application/json" },
      body: JSON.stringify(payload)
    });
    if (!res.ok) {
      console.error(`${label} send failed: ${res.status} ${(await res.text()).slice(0, 200)}`);
      return "send_failed";
    }
    return "sent";
  } catch (e) {
    console.error(`${label} error: ${safeLogError(e)}`);
    return "send_failed";
  }
}
