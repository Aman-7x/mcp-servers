    does: "Pass 1\u20131000 structured records, each with exact entity and supplier IDs, document type, reference, date, currency and positive integer minor-unit total. Three independent equality rules retain original records and overlapping reasons. A candidate is a review prompt, not a confirmed duplicate or payment decision. No ERP, PDF extraction or implicit stored history.",
    prompts: [
      ["Review INV-001 and inv /001 from the same supplier and entity; retain INV-1 as a distinct leading-zero reference.", "duplicate_invoice_check"],
      ["Show the same reference even when its amount and invoice date differ, keeping both original values.", "duplicate_invoice_check"],
      ["Save the review and export the complete source records and candidate reasons as CSV.", "report_export_csv"]
    ],
    free: "Every diagnostic up to 1000 records, complete free evidence pages, CSV and three concurrent saved reports.",
    pro: "$19 once removes only the saved-report count cap; the $39 bundle includes it. Every tier keeps the 64 MiB aggregate storage and input/output bounds.",
    measured: "Frozen operator round 46 checks five buyer tasks through actual local MCP stdio calls. These are synthetic operator tests, not customer research."
  },
  "three-way-match": {
    title: "MCP Three-Way Invoice Match",
    slug: "three-way-match",
    toolCount: "8 tools",
    pkg: "@theluckystrike/mcp-three-way-match",
    sPage: "/s/three-way-match",
    hosted: null,
    tagline: "Compare supplier invoice lines with purchase orders and accepted receipt quantities by exact SKU.",
    does: "Pass a structured PO, dated receipt notes, one invoice and an explicit prior_invoiced array. Every exception shows the ordered, accepted, previously billed and currently billed quantities alongside the PO and invoice unit prices. Money uses integer minor units and quantities use whole units. The server does not read PDFs, query an ERP, infer past bills or approve payment.",
    prompts: [
      ["Check PO A10/B10 at 100 minor units each against accepted receipts A5/B15 and invoice A10/B10. Prior invoiced is empty: find the hidden SKU mismatch.", "three_way_match"],
      ["Now invoice only A5/B10 against the same order and receipts; explain any over-receipt still reported on B.", "three_way_match"],
      ["Save this exception report and export its CSV for review.", "report_export_csv"]
    ],
    free: "Every full preview up to 500 PO/invoice lines, free pages of large reports, three simultaneous saved reports, retrieval, deletion and CSV export.",
    pro: "Unlimited saved reports for $19 once. Both tiers keep the same per-check safety bounds.",
    measured: "The offsetting-SKU example and partial-delivery acceptance case are documented in the server README and tests."
  },
  "time-tracker": {
    title: "MCP Time Tracker",
    slug: "time-tracker",
