    assert3(inspected <= MAX_OBJECTS, "webhook status list coverage incomplete");
    if (page2.list_complete) break;
    assert3(page2.cursor && page2.cursor !== cursor, "webhook status pagination stalled");
    cursor = page2.cursor;
  } while (true);
  return { inspected, failed };
}
